# Copy to .env (git-ignored) and replace every REPLACE_ME value. NEVER commit .env.

# Public HTTPS URL the Cloudflare tunnel serves this on, e.g. https://mail-mcp.example.com
PUBLIC_URL=REPLACE_ME
# Local port (loopback only); the tunnel's public hostname must point at http://127.0.0.1:<PORT>.
PORT=8787

# The only Google account allowed to sign in to the connector, e.g. you@gmail.com
OWNER_EMAIL=REPLACE_ME

# Google Cloud OAuth client (Web application). Authorized redirect URIs:
#   <PUBLIC_URL>/oauth/google/callback   and   http://localhost:<LINK_PORT>/callback
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Credentials claude.ai uses for this server (Connector > Advanced settings).
# Generate: node -e "console.log(crypto.randomBytes(16).toString('hex'))"   (client id)
#           node -e "console.log(crypto.randomBytes(32).toString('base64url'))"   (client secret)
MCP_CLIENT_ID=REPLACE_ME
MCP_CLIENT_SECRET=REPLACE_ME

# Encrypts $DATA_DIR/state.enc (linked accounts' Google refresh tokens).
# Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_ME

DATA_DIR=./data

# Comma-separated tool modules to enable (see src/modules/). Changing this requires re-running
# `npm run link` for each account so it grants the new modules' Google scopes.
MODULES=mail,calendar

# Optional: comma-separated calendar IDs the calendar tools read by default ("primary" = each
# account's main calendar). Defaults to the calendars shown in Google Calendar.
# CALENDAR_IDS=primary,family@group.calendar.google.com

# Local port `npm run link` listens on for Google's redirect.
LINK_PORT=8788

# Optional: comma-separated OAuth redirect URIs to allow. Defaults to claude.ai's callbacks.
# REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel). Read by cloudflared.
TUNNEL_TOKEN=REPLACE_ME
